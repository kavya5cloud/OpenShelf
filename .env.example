# Postgres connection string. On Vercel, the Neon integration sets this for you.
DATABASE_URL=postgres://user:password@host:5432/openshelf

# Secret used to sign login tokens. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me

# Library's local timezone, used to decide what "today" is for due dates.
LIBRARY_TZ=Asia/Kolkata
